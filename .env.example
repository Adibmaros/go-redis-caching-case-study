APP_PORT=8080
APP_HOST=0.0.0.0
APP_ENV=development

# MySQL DSN: sesuaikan dengan kredensial MySQL lokal Anda (berjalan di host, bukan container)
MYSQL_DSN=root:@tcp(localhost:3306)/redis_case?parseTime=true&charset=utf8mb4
MYSQL_MAX_OPEN_CONNS=20
MYSQL_MAX_IDLE_CONNS=10

# Redis Connection (Podman port forwarding di IP 192.168.54.202:6379 atau localhost:6379)
REDIS_ADDR=192.168.54.202:6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache switch: true = aktifkan Redis cache, false = bypass langsung ke MySQL (untuk benchmark)
CACHE_ENABLED=true

# Rate Limiter (req per menit per client IP)
RATE_LIMIT_PER_MIN=100

# TTL dalam detik
TTL_PRODUCT_DETAIL=300
TTL_PRODUCT_LIST=120
TTL_TOP_PRODUCTS=600
TTL_DASHBOARD=60
